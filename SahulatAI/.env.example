# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file or share your API key.

# Groq API key — used for the chat/agent model. Free tier available.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Chat model served by Groq. As of Aug 2026, Groq has deprecated the old
# llama-3.3-70b-versatile / llama-3.1-8b-instant models — openai/gpt-oss-120b
# is the current recommended general-purpose, tool-calling model. See
# https://console.groq.com/docs/models for the up-to-date list (and
# https://console.groq.com/docs/deprecations for shutdown dates).
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# --- Optional: better RAG embeddings ---
# xAI's Grok API has no embeddings endpoint, so this project uses a small
# local, dependency-free fallback embedding by default (fine for a modest
# knowledge base, but lower quality than a real embedding model). If you'd
# like higher-quality semantic search, set a Google AI Studio key below and
# it will be used automatically instead — get one free at
# https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_key_here
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Wake word for hands-free mode
WAKE_WORD=Hi Sahulat

# Optional: Porcupine access key for local wake-word engine (free tier).
# Leave blank to use the built-in fuzzy-match fallback (no key needed).
PORCUPINE_ACCESS_KEY=

# RAG tuning
# NOTE: min/strong relevance scores are tuned for the local, dependency-free
# fallback embedding used when GEMINI_API_KEY is not set. If you add a
# Gemini key for real semantic embeddings, consider raising these back up
# (e.g. 0.35 / 0.55) since real embeddings score meaningfully higher.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_RELEVANCE_SCORE=0.15
STRONG_RELEVANCE_SCORE=0.28

# Agent limits
MAX_TOOL_CALLS=5

# Paths (relative to project root — usually leave as-is)
CHROMA_DB_DIR=data/chroma_db
SQLITE_DB_PATH=data/sahulatai.db

# Crawler
CRAWL_MAX_DEPTH=2
CRAWL_MAX_PAGES=60
CRAWL_TIMEOUT_SECONDS=10
CRAWL_USER_AGENT=SahulatAI-Bot/1.0 (+local hackathon project; contact: dev@example.com)


# --- WhatsApp Cloud API ---
# Get these from Meta Developers / WhatsApp Business Platform.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-this-to-a-random-secret
# Use the current Graph API version shown by Meta when you configure the app,
# for example: vXX.X
WHATSAPP_API_VERSION=
# Meta App Secret. Recommended for production webhook signature verification.
WHATSAPP_APP_SECRET=
